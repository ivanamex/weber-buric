{
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/|icons/|api/|.*\\..*).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/reminders.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 60
    },
    "api/contact.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 30
    },
    "api/enroll.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 30
    },
    "api/mp-checkout.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 30
    },
    "api/mp-webhook.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 30
    },
    "api/mp-pay.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 30
    },
    "api/shop-order.js": {
      "includeFiles": "scripts/supabase-ca.crt",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
